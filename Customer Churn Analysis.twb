      <aliases enabled='yes' />
      <column caption='Churn Flag' datatype='integer' name='[Calculation_1235956668546797568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Churn Rate ' datatype='real' name='[Calculation_1235956668546863105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1235956668546797568]) / COUNT([customerID])' />
      </column>
      <column caption='Tenure Group ' datatype='string' name='[Calculation_1235956668548685826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0–12 Months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;13–24 Months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;25–48 Months&quot;&#13;&#10;ELSE &quot;49+ Months&quot;&#13;&#10;END' />
      </column>
